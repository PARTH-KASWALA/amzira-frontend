# Public storefront configuration. Do not put private backend or payment
# secrets in this file or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SITE_URL=https://www.amzira.com
NEXT_PUBLIC_API_BASE_URL=https://api.amzira.com/api/v1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_ENABLE_CATALOG_FALLBACK=false
NEXT_PUBLIC_LIVE_CATEGORY_API_SLUG=kids

# Only set this if the backend does not return the Razorpay key in the
# payment-order response. This is a public key, never a Razorpay secret.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_replace_me
